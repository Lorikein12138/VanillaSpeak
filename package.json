{
  "name": "webspeak-webclient",
  "version": "0.3.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Server-side browser gateway for TeamSpeak — deploy on your server, users join from any browser",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "node --import tsx --test --test-concurrency=2 \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\" \"web/src/**/*.test.ts\" \"web/test/**/*.test.{ts,mjs}\"",
    "test:backend": "node --import tsx --test --test-concurrency=2 \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "test:frontend": "node --import tsx --test --test-concurrency=2 \"web/src/**/*.test.ts\" \"web/test/**/*.test.{ts,mjs}\"",
    "verify": "npm test && npm run build && npm run web:build",
    "skin:harbor:build": "node web/scripts/build-harbor-voice-skin.mjs",
    "skin:open-voice:build": "node web/scripts/build-open-voice-surface-skin.mjs",
    "skin:host-chrome:build": "node web/scripts/build-host-chrome-demo-skin.mjs",
    "start": "node dist/index.js",
    "web:dev": "cd web && npx vite --host",
    "web:build": "npm --prefix web run build",
    "skin:wasm:build": "node scripts/build-skin-wasm-interpreter.mjs",
    "android:prepare": "npm run build && npm --prefix web run build && node mobile/pack.mjs",
    "android:sync": "npm run android:prepare && cd web && npx cap sync android",
    "acceleration:poc": "node scripts/acceleration-poc/smoke.mjs",
    "acceleration:ipv6-smoke": "node scripts/acceleration-poc/smoke-ipv6.mjs",
    "acceleration:sdk-smoke": "node scripts/acceleration-poc/sdk-smoke.mjs",
    "acceleration:relay": "node dist/relay.js",
    "plugin:build": "node scripts/build-plugin.mjs"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@honeybbq/teamspeak": "1.0.0-beta.23",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "postcss": "^8.5.29",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0",
    "ssh2": "^1.17.0",
    "werift": "0.24.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "body-parser": "^2.3.0",
    "esbuild": "^0.28.2",
    "tar": "^7.5.22"
  }
}
